# Railway: generate both secrets, and keep them private
INGEST_TOKEN=replace-with-long-random-string
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=replace-with-long-random-password
DISCORD_WEBHOOK_URL=
DB_PATH=/app/data/vc.db
CLOUD_POLL_ENABLED=false
# Optional authorized JSON endpoint; no JKT48 internal endpoint is assumed
CLOUD_SOURCE_URL=
CLOUD_SOURCE_BEARER=
POLL_SECONDS=60
# Optional alert on initial inventory snapshot (default off)
ALERT_INITIAL=false
